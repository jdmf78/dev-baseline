{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.ssh/*": "deny",
      "~/.config/gh/*": "deny",
      "~/.claude/.credentials.json": "deny",
      "~/.codex/auth.json": "deny",
      "~/.local/share/opencode/*": "deny"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny"
    }
  }
}
