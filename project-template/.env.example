# Copy to .env (gitignored) and fill in. Commit placeholders only.

# Shared secret for GitHub webhook signatures. Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# Port the webhook service listens on
PORT=3000

# owner/name of the repo whose events `just webhook-forward` relays
GITHUB_REPO=

# Public hostname for deploy/compose.yaml; Caddy fetches its TLS certificate
DOMAIN=
